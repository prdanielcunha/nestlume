# NestLume first batch intentionally has no runtime secrets.
# AI remains disabled until F1 is approved and a server-side provider is configured.

# Public endpoint only. Never place Cloudflare/OpenAI/Google credentials here.
# VITE_NESTLUME_AI_ENDPOINT=https://<approved-server-side-adapter>

# Public Turnstile sitekey only. The secret belongs only in the Worker secret store.
# VITE_NESTLUME_TURNSTILE_SITE_KEY=<public-sitekey>
