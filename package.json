{
  "name": "nestlume",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "predev": "npm run corpus:build",
    "dev": "vite --host 0.0.0.0",
    "lint": "tsc --noEmit",
    "corpus:check": "node scripts/build-corpus.mjs --check",
    "corpus:build": "node scripts/build-corpus.mjs",
    "test": "npm run corpus:check && tsx --test tests/*.test.ts",
    "build": "npm run corpus:build && vite build",
    "check": "npm run lint && npm run test && npm run build",
    "ai:battery": "node scripts/run-ai-battery.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "vite": "6.2.3",
    "typescript": "5.8.2",
    "react": "19.0.1",
    "react-dom": "19.0.1"
  },
  "devDependencies": {
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "tsx": "4.21.0",
    "@types/node": "22.15.0"
  }
}
